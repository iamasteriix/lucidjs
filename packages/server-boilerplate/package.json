{
  "name": "@lucidjs/server-boilerplate",
  "description": "Welcome to the playground, powered by Express",
  "version": "0.1.0",
  "private": false,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev --import ./src/telemetry/index.ts src/index.ts",
    "test:unit": "vitest run unit.test",
    "test:i9n": "vitest run i9n.test",
    "test:e2e": "playwright test",
    "build": "tsc",
    "start": "node --import ./dist/telemetry/index.js dist/index.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "express": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "dotenv": "18.0.2",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
